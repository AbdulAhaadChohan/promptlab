{
  "name": "classify-smoke",
  "prompt_file": "prompts/classify_v1.txt",
  "model": { "temperature": 0.0, "max_tokens": 256 },
  "runs": 3,
  "cases": [
    {
      "id": "c001",
      "input": "I was charged twice for invoice 7",
      "assert": [
        { "type": "json_valid" },
        { "type": "json_field_equals", "field": "category", "value": "billing" }
      ]
    },
    {
      "id": "c002",
      "input": "The application crashes whenever I click submit button",
      "assert": [
        { "type": "json_valid" },
        { "type": "json_field_equals", "field": "category", "value": "technical" }
      ]
    },
    {
      "id": "c003",
      "input": "I need help with something",
      "assert": [
        { "type": "json_valid" },
        { "type": "json_field_equals", "field": "category", "value": "unclear" }
      ]
    }
  ]
}